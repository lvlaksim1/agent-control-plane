{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable Task Request",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "issuer_agent_id",
    "target_agent_id",
    "objective",
    "authority_basis",
    "scope",
    "constraints",
    "target",
    "priority",
    "dependencies",
    "completion_contract",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "issuer_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "target_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "authority_basis": {
      "type": "object"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target": {
      "type": "object",
      "required": [
        "repository",
        "ref"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "priority": {
      "enum": [
        "critical",
        "high",
        "normal",
        "low"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "relation"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "relation": {
            "const": "depends_on"
          }
        }
      }
    },
    "workflow_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "relation": {
      "type": [
        "string",
        "null"
      ]
    },
    "completion_contract": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "responsibility": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "commitment_owner_agent_id",
            "return_to_agent_id"
          ],
          "properties": {
            "mode": {
              "enum": [
                "bounded_delegation",
                "explicit_handoff"
              ]
            },
            "commitment_owner_agent_id": {
              "type": "string",
              "minLength": 1
            },
            "return_to_agent_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    }
  }
}
