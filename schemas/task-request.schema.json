{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable Task Request",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "issuer_agent_id",
    "target_agent_id",
    "objective",
    "authority_basis",
    "scope",
    "constraints",
    "target",
    "priority",
    "dependencies",
    "completion_contract",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "issuer_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "target_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "authority_basis": {
      "type": "object"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target": {
      "type": "object",
      "required": [
        "repository",
        "ref"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "priority": {
      "enum": [
        "critical",
        "high",
        "normal",
        "low"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "relation"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "relation": {
            "const": "depends_on"
          }
        }
      }
    },
    "workflow_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "relation": {
      "type": [
        "string",
        "null"
      ]
    },
    "completion_contract": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "responsibility": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "commitment_owner_agent_id",
            "return_to_agent_id"
          ],
          "properties": {
            "mode": {
              "enum": [
                "bounded_delegation",
                "explicit_handoff"
              ]
            },
            "commitment_owner_agent_id": {
              "type": "string",
              "minLength": 1
            },
            "return_to_agent_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantics_version",
            "mode",
            "caller_agent_id",
            "commitment_owner_agent_id",
            "proposed_commitment_owner_agent_id",
            "return_to_agent_id",
            "transfer_requires_target_acceptance",
            "authority_chain"
          ],
          "properties": {
            "semantics_version": {
              "const": 2
            },
            "mode": {
              "enum": [
                "bounded_delegation",
                "explicit_handoff"
              ]
            },
            "caller_agent_id": {
              "type": "string",
              "minLength": 1
            },
            "commitment_owner_agent_id": {
              "type": "string",
              "minLength": 1
            },
            "proposed_commitment_owner_agent_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "return_to_agent_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "transfer_requires_target_acceptance": {
              "type": "boolean"
            },
            "authority_chain": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "root",
                "immediate_grantor_agent_id",
                "grant_reference",
                "delegation_depth",
                "parent_task_id",
                "allowed_effects",
                "forbidden_effects",
                "subdelegation"
              ],
              "properties": {
                "root": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "reference"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reference": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "immediate_grantor_agent_id": {
                  "type": "string",
                  "minLength": 1
                },
                "grant_reference": {
                  "type": "string",
                  "minLength": 1
                },
                "delegation_depth": {
                  "type": "integer",
                  "minimum": 1
                },
                "parent_task_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "allowed_effects": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "forbidden_effects": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "subdelegation": {
                  "enum": [
                    "forbidden",
                    "bounded"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
