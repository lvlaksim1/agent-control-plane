{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task State",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "status",
    "request_digest",
    "attempt",
    "runtime_loss_count",
    "claim",
    "latest_checkpoint",
    "request_blob_sha"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "claimed",
        "active",
        "waiting",
        "blocked",
        "quarantined",
        "completed",
        "cancelled",
        "superseded"
      ]
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "runtime_loss_count": {
      "type": "integer",
      "minimum": 0
    },
    "claim": {
      "type": [
        "object",
        "null"
      ]
    },
    "latest_checkpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_blob_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "carrier": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "carrier_id",
            "set_by",
            "reason",
            "heartbeat_at",
            "lease_until",
            "fallback_after_expiry"
          ],
          "properties": {
            "mode": {
              "enum": [
                "live",
                "hold"
              ]
            },
            "carrier_id": {
              "type": "string",
              "minLength": 1
            },
            "set_by": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "heartbeat_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "lease_until": {
              "type": [
                "string",
                "null"
              ]
            },
            "fallback_after_expiry": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "continuation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "status",
            "continuation_id",
            "return_to_agent_id",
            "commitment_owner_agent_id",
            "parent_task_id",
            "workflow_id",
            "request_digest",
            "request_blob_sha",
            "result_carrier_id",
            "live_lease_until",
            "consumed_by_agent_id",
            "consumed_at"
          ],
          "properties": {
            "kind": {
              "const": "return_to_caller"
            },
            "status": {
              "enum": [
                "pending",
                "consumed"
              ]
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            },
            "return_to_agent_id": {
              "type": "string",
              "minLength": 1
            },
            "commitment_owner_agent_id": {
              "type": "string",
              "minLength": 1
            },
            "parent_task_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "workflow_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "request_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "request_blob_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "result_carrier_id": {
              "type": "string",
              "minLength": 1
            },
            "live_lease_until": {
              "type": "string",
              "format": "date-time"
            },
            "consumed_by_agent_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "consumed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        }
      ]
    },
    "responsibility_acceptance": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_digest",
            "accepted_by_agent_id",
            "accepted_at",
            "projected_at",
            "source",
            "execution_fence"
          ],
          "properties": {
            "request_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "accepted_by_agent_id": {
              "type": "string",
              "minLength": 1
            },
            "accepted_at": {
              "type": "string",
              "format": "date-time"
            },
            "projected_at": {
              "type": "string",
              "format": "date-time"
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "authority_ref",
                "commit_sha",
                "path",
                "blob_sha",
                "record_id"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "authority_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "commit_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "path": {
                  "type": "string",
                  "pattern": "^\\.context/responsibility/acceptances/.+\\.json$"
                },
                "blob_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "record_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "execution_fence": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "execution_id",
                    "generation",
                    "activation_projection_blob_sha"
                  ],
                  "properties": {
                    "mode": {
                      "const": "autonomous"
                    },
                    "execution_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "generation": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "activation_projection_blob_sha": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "carrier_id",
                    "lease_until"
                  ],
                  "properties": {
                    "mode": {
                      "const": "live"
                    },
                    "carrier_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "lease_until": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
