{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task State",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "status",
    "request_digest",
    "attempt",
    "runtime_loss_count",
    "claim",
    "latest_checkpoint",
    "request_blob_sha"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "claimed",
        "active",
        "waiting",
        "blocked",
        "quarantined",
        "completed",
        "cancelled",
        "superseded"
      ]
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "runtime_loss_count": {
      "type": "integer",
      "minimum": 0
    },
    "claim": {
      "type": [
        "object",
        "null"
      ]
    },
    "latest_checkpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_blob_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "carrier": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "carrier_id",
            "set_by",
            "reason",
            "heartbeat_at",
            "lease_until",
            "fallback_after_expiry"
          ],
          "properties": {
            "mode": {
              "enum": [
                "live",
                "hold"
              ]
            },
            "carrier_id": {
              "type": "string",
              "minLength": 1
            },
            "set_by": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "heartbeat_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "lease_until": {
              "type": [
                "string",
                "null"
              ]
            },
            "fallback_after_expiry": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
