{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task Result",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "outcome",
    "summary",
    "evidence",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string"
    },
    "outcome": {
      "const": "success"
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "reference",
          "verified",
          "verified_by",
          "verified_at"
        ]
      }
    },
    "completed_at": {
      "type": "string"
    }
  }
}\n