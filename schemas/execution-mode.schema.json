{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-mode.schema.json",
  "title": "Agent Control Plane Execution Mode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "autonomous_scheduler_allowed",
    "fallback_after_presence_expiry",
    "set_by",
    "authority",
    "reason",
    "set_at",
    "presence",
    "owner_hold"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "mode": {
      "enum": [
        "interactive",
        "autonomous",
        "hold"
      ]
    },
    "autonomous_scheduler_allowed": {
      "type": "boolean"
    },
    "fallback_after_presence_expiry": {
      "type": "boolean"
    },
    "set_by": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "set_at": {
      "type": "string",
      "format": "date-time"
    },
    "presence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "carrier_id",
            "heartbeat_at",
            "lease_until"
          ],
          "properties": {
            "carrier_id": {
              "type": "string",
              "minLength": 1
            },
            "heartbeat_at": {
              "type": "string",
              "format": "date-time"
            },
            "lease_until": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "owner_hold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "reason",
        "set_by",
        "set_at"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "set_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "set_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
