{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate Contract",
  "type": "object",
  "required": [
    "schema_version",
    "gate_id",
    "task_id",
    "gate_type",
    "status",
    "required_actor_id",
    "requested_at",
    "resolved_at",
    "resolution"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "gate_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "gate_type": {
      "enum": [
        "owner_decision",
        "authority",
        "external_dependency",
        "audit",
        "release_approval"
      ]
    },
    "status": {
      "enum": [
        "waiting",
        "satisfied",
        "cancelled"
      ]
    },
    "required_actor_id": {
      "type": "string"
    },
    "requested_at": {
      "type": "string"
    },
    "resolved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolution": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}\n