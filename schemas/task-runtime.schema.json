{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task Runtime Metadata",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "failure_count",
    "retry_not_before",
    "last_failure"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string"
    },
    "failure_count": {
      "type": "integer",
      "minimum": 0
    },
    "retry_not_before": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_failure": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
