{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task Runtime Metadata",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "failure_count",
    "retry_not_before",
    "last_failure"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string"
    },
    "failure_count": {
      "type": "integer",
      "minimum": 0
    },
    "retry_not_before": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_failure": {
      "type": [
        "object",
        "null"
      ]
    },
    "carrier": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "carrier_id",
            "set_by",
            "reason",
            "heartbeat_at",
            "lease_until",
            "fallback_after_expiry"
          ],
          "properties": {
            "mode": {
              "enum": [
                "live",
                "hold"
              ]
            },
            "carrier_id": {
              "type": "string",
              "minLength": 1
            },
            "set_by": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "heartbeat_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "lease_until": {
              "type": [
                "string",
                "null"
              ]
            },
            "fallback_after_expiry": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
