{
  "schema_version": 2,
  "claim": {
    "required_fields": [
      "execution_id",
      "generation",
      "slot_id",
      "claimed_at"
    ],
    "claimed_at_source": "authoritative gateway claim/commit time",
    "state_status": "claimed"
  },
  "result": {
    "required_fields": [
      "schema_version",
      "task_id",
      "request_digest",
      "request_blob_sha",
      "execution_id",
      "generation",
      "outcome",
      "summary",
      "evidence",
      "completed_at"
    ],
    "fixed_values": {
      "schema_version": 1,
      "outcome": "success"
    },
    "evidence_required_fields": [
      "kind",
      "reference",
      "verified",
      "verified_by",
      "verified_at"
    ],
    "evidence_verified_must_be_true": true,
    "completion_rule": "all completion_contract evidence minima satisfied before state=completed",
    "completed_at_semantics": "execution-local metadata; parseable timestamp only; never authoritative for lifecycle ordering"
  },
  "completion": {
    "order": [
      "result.json durable",
      "state=completed with claim=null durable and re-read",
      "gateway release accepted",
      "dispatcher heartbeat"
    ],
    "lease_must_remain_active_until": "completed state re-read succeeds",
    "completed_state_requirements": {
      "status": "completed",
      "claim": null
    },
    "authoritative_order_source": "Git commit chronology for result/state plus authoritative gateway transition commits",
    "ordering_rule": "result.json durable commit precedes completed-state durable commit; completed-state durable commit precedes accepted gateway release commit"
  },
  "reservation": {
    "gateway_claim_result": "reserved",
    "target_writes_authorized": false,
    "next_steps": [
      "CAS task state to claimed and re-read",
      "capture claimed state Git blob SHA",
      "gateway activate with activation_projection_blob_sha",
      "record activation_projection_blob_sha inside task claim and re-read",
      "STOP this dispatcher invocation"
    ]
  },
  "execution_admission": {
    "required_gateway_state": "active",
    "required_private_state_before_reinstantiation": "claimed",
    "required_private_state_before_consequential_write": "active",
    "required_match": [
      "task_id",
      "agent_id",
      "execution_id",
      "generation",
      "slot_id",
      "request_blob_sha",
      "activation_projection_blob_sha"
    ],
    "same_invocation_as_reservation": false
  }
}
