{
  "schema_version": 2,
  "protocol": "docs/BOUNDED_RUNTIME_RESULT_RELAY.md",
  "prefix": "ACP_RUNTIME_RELAY_V2|",
  "transport": "scheduled-task-self-prompt",
  "transport_authority": "non-canonical",
  "max_prompt_chars": 12000,
  "legacy_read_support": {
    "prefix": "ACP_RUNTIME_RELAY_V1|",
    "accept_as_new_canonical_result": false,
    "purpose": "historical diagnostics only"
  },
  "reasoning_phase": {
    "gateway_lease_required": false,
    "external_writes_allowed": false,
    "only_write": "automations.update on the same Scheduled Task prompt",
    "runtime_loss_effect": "no gateway lease is stranded; retry increments attempt and uses a new transport_task_id + relay_id + relay_nonce"
  },
  "envelope": {
    "required_fields": [
      "schema_version",
      "relay_id",
      "transport_task_id",
      "task_id",
      "attempt",
      "request_digest",
      "request_blob_sha",
      "relay_nonce",
      "author_id",
      "author_kind",
      "status",
      "terminal",
      "payload_kind",
      "payload_encoding",
      "payload_text",
      "payload_sha256",
      "authored_at_msk"
    ],
    "fixed_values": {
      "schema_version": 2,
      "terminal": true,
      "payload_encoding": "utf-8"
    },
    "attempt": "positive integer bound to the currently authorized runtime attempt",
    "author_kind": [
      "persistent-agent",
      "infrastructure"
    ],
    "status": [
      "complete",
      "blocked"
    ],
    "payload_integrity": "payload_sha256 must equal SHA-256 of exact UTF-8 bytes of payload_text"
  },
  "mechanical_acceptance": {
    "exact_match": [
      "relay_id",
      "transport_task_id",
      "task_id",
      "attempt",
      "request_digest",
      "request_blob_sha",
      "relay_nonce",
      "author_id"
    ],
    "current_attempt_required": true,
    "terminal_required": true,
    "persist_raw_relay_before_semantic_writes": true,
    "reinterpret_payload": false,
    "stale_attempt_behavior": "fail-closed",
    "stale_nonce_behavior": "fail-closed",
    "payload_hash_mismatch_behavior": "fail-closed",
    "blocked_status_behavior": "persist blocker only; never fabricate success",
    "idempotence": {
      "receipt_scope": "one canonical acceptance receipt per task_id",
      "same_raw_relay_and_same_receipt": "already-accepted/no-op",
      "different_relay_after_receipt": "conflict/fail-closed",
      "later_attempt_after_receipt": "conflict/fail-closed because a canonical result already exists"
    },
    "acceptance_receipt_fields": [
      "schema_version",
      "task_id",
      "attempt",
      "relay_id",
      "relay_nonce",
      "transport_task_id",
      "request_digest",
      "request_blob_sha",
      "author_id",
      "status",
      "payload_kind",
      "raw_relay_sha256",
      "payload_sha256"
    ]
  },
  "canonical_persistence": {
    "raw_relay": "tasks/<task_id>/relay/raw.txt",
    "acceptance_receipt": "tasks/<task_id>/relay/acceptance.json",
    "authored_payload": "tasks/<task_id>/relay/payload.txt",
    "write_rule": "persist exact raw relay and exact UTF-8 payload bytes; receipt is mechanical metadata derived from validated relay",
    "duplicate_rule": "an exact duplicate never rewrites or duplicates canonical payload/result state"
  },
  "persistence_phase": {
    "gateway_acquired_after_relay_received": true,
    "gateway_scope": "short mechanical persistence only",
    "completion_order": [
      "validated raw relay durable",
      "acceptance receipt durable",
      "exact authored payload durable",
      "gateway claim/activation if required",
      "exact authored operations applied under current base preconditions",
      "canonical result durable",
      "terminal state durable and re-read",
      "gateway release accepted"
    ]
  },
  "identity": {
    "max_persistent_agents_per_relay_runtime": 1,
    "same_runtime_identity_switch_allowed": false,
    "infrastructure_probe_reinstantiates_agent": false
  },
  "operational_state": "v2-contract-ready-pending-end-to-end-runtime-loss-proof"
}
